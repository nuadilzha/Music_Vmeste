{
  "name": "music-vmeste",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test --test-timeout=60000 server/*.test.mjs tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-vm-modules scripts/check-running.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "node --env-file-if-exists=.env server/index.mjs",
    "format": "prettier --write src server scripts tests *.json *.ts *.html *.md .github/workflows/*.yml",
    "format:check": "prettier --check src server scripts tests *.json *.ts *.html *.md .github/workflows/*.yml"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
